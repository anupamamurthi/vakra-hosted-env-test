# Copy to .env and fill in one provider. .env is gitignored.

# ── watsonx ───────────────────────────────────────────────
LLM_PROVIDER=watsonx
MODEL=openai/gpt-oss-120b
WATSONX_APIKEY=            # IBM Cloud API key
WATSONX_PROJECT_ID=        # watsonx.ai project ID
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ── RITS (IBM network only) ───────────────────────────────
# LLM_PROVIDER=rits
# RITS_API_KEY=
# RITS_BASE_URL=https://inference-3scale-apicast-production.apps.rits.fmaas.res.ibm.com/google-gemma-4-31b-it-a100/v1
# MODEL=google/gemma-4-31B-it

# ── Any other LangChain model (leave LLM_PROVIDER unset) ──
# MODEL=openai:gpt-4.1
# OPENAI_API_KEY=

# ── VAKRA ─────────────────────────────────────────────────
# MCP_DOMAIN=california_schools
